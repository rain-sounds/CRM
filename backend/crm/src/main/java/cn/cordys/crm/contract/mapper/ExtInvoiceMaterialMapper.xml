<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">

<mapper namespace="cn.cordys.crm.contract.mapper.ExtInvoiceMaterialMapper">

    <select id="list" resultType="cn.cordys.crm.contract.dto.response.InvoiceMaterialListResponse">
        SELECT
        im.*
        FROM
        invoice_material im
        WHERE
        im.organization_id = #{orgId}
        <if test="request.keyword != null and request.keyword != ''">
            and im.hospital_name like concat('%', #{request.keyword},'%')
        </if>

        <include refid="filters">
            <property name="filters" value="request.filters"/>
        </include>

        <include refid="combine">
            <property name="combineSearch" value="request.combineSearch"/>
        </include>
        <include refid="sort">
            <property name="sort" value="request.sort"/>
        </include>
    </select>

    <sql id="filters">
        <if test="${filters} != null and ${filters}.size() > 0">
            <trim prefix="and">
                <foreach collection="${filters}" item="condition" open="(" close=")" index="i" separator="and">
                    <include refid="condition">
                        <property name="condition" value="condition"/>
                    </include>
                </foreach>
            </trim>
        </if>
    </sql>

    <sql id="condition">
        <choose>
            <when test="condition.name == 'hospitalName'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.hospital_name"/>
                </include>
            </when>
            <when test="condition.name == 'invoice'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.invoice"/>
                </include>
            </when>
            <when test="condition.name == 'verificationProof'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.verification_proof"/>
                </include>
            </when>
            <when test="condition.name == 'sampleMailing'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.sample_mailing"/>
                </include>
            </when>
            <when test="condition.name == 'samplePhoto'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.sample_photo"/>
                </include>
            </when>
            <when test="condition.name == 'report'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.report"/>
                </include>
            </when>
            <when test="condition.name == 'outboundOrder'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.outbound_order"/>
                </include>
            </when>
            <when test="condition.name == 'contract'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.contract"/>
                </include>
            </when>
            <when test="condition.name == 'platform'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.platform"/>
                </include>
            </when>
            <when test="condition.name == 'otherMaterials'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.other_materials"/>
                </include>
            </when>
            <when test="condition.name == 'sequence'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.sequence"/>
                </include>
            </when>
            <when test="condition.name == 'createTime'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.create_time"/>
                </include>
            </when>
            <when test="condition.name == 'updateTime'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.update_time"/>
                </include>
            </when>
            <when test="condition.name == 'createUser'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.create_user"/>
                </include>
            </when>
            <when test="condition.name == 'updateUser'">
                <include refid="cn.cordys.common.mapper.CommonMapper.condition">
                    <property name="condition" value="condition"/>
                    <property name="column" value="im.update_user"/>
                </include>
            </when>
        </choose>
    </sql>

    <sql id="combine">
        <if test="${combineSearch} != null and ${combineSearch}.conditions != null and ${combineSearch}.conditions.size() > 0">
            <trim prefix="and">
                <trim prefix="(" suffix=")" suffixOverrides="and|or">
                    <foreach collection="${combineSearch}.conditions" index="i" item="condition">
                        <include refid="condition">
                            <property name="condition" value="condition"/>
                        </include>
                        <include refid="cn.cordys.common.mapper.CommonMapper.searchMode">
                            <property name="searchMode" value="${combineSearch}.searchMode"/>
                        </include>
                    </foreach>
                </trim>
            </trim>
        </if>
    </sql>

    <sql id="sort">
        <choose>
            <when test="${sort} != null and ${sort}.valid()">
                <bind name="sortType" value="${sort}.type"/>
                <bind name="sortName" value="${sort}.name"/>
                order by
                <choose>
                    <when test="${sort}.name in
                        {'sequence', 'hospital_name', 'invoice', 'verification_proof', 'sample_mailing',
                         'sample_photo', 'report', 'outbound_order', 'contract', 'platform',
                         'other_materials', 'create_time', 'update_time', 'create_user', 'update_user'
                        }">
                        im.${sortName} ${sortType}, im.id ASC
                    </when>
                    <otherwise>
                        order by im.sequence asc, im.id asc
                    </otherwise>
                </choose>
            </when>
            <otherwise>
                order by im.sequence asc, im.id asc
            </otherwise>
        </choose>
    </sql>

    <select id="getMaxSequence" resultType="java.lang.Integer">
        SELECT MAX(sequence) FROM invoice_material WHERE organization_id = #{orgId}
    </select>

</mapper>
